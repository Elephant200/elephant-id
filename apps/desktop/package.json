{
  "name": "alphaphant-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Alphaphant: offline desktop app for identifying individual African elephants",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "demo": "npm run build && ALPHAPHANT_GALLERY_PROFILES=../../outputs/alphaphant_demo/gallery_profiles.npz ALPHAPHANT_DATA_DIR=../../outputs/alphaphant_demo/data electron ."
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
