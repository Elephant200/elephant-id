# require-corp so Safari also gets cross-origin isolation (wasm threads); Safari
# does not support credentialless. This blocks Cloudflare Web Analytics' cross-
# origin beacon (it collects nothing here), so turn Web Analytics off for this
# project in the Cloudflare dashboard to drop its console error and beacon.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
